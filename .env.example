# Local development defaults and placeholders. Replace every password placeholder.
MYSQL_HOST=127.0.0.1
# The application is reachable from other computers on the LAN.
APP_BIND_ADDRESS=0.0.0.0
# Keep MySQL, Redis, RabbitMQ and MinIO ports local to this computer.
MIDDLEWARE_BIND_ADDRESS=127.0.0.1

MYSQL_DATABASE=track_analysis
MYSQL_USER=track_app
MYSQL_PASSWORD=replace-with-a-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3306

# Base64-encoded random secret representing at least 32 bytes; never reuse this placeholder.
JWT_SECRET=<generate-a-base64-secret-at-least-32-bytes>
JWT_ACCESS_TTL_MINUTES=120
JWT_ISSUER=track-analysis-platform
APP_PUBLIC_REGISTRATION_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
APP_ADMIN_USERNAME=replace-with-initial-admin-username
APP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
WEB_SESSION_TIMEOUT=30m
WEB_SESSION_COOKIE_SECURE=false

# Redis password: 16-128 characters using only A-Z, a-z, 0-9, dot, underscore, or hyphen.
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_PORT=6379
REDIS_HOST=127.0.0.1

RABBITMQ_DEFAULT_USER=track_app
RABBITMQ_DEFAULT_PASS=replace-with-a-local-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=track_app
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_CONCURRENCY=2
RABBITMQ_MAX_CONCURRENCY=8
RABBITMQ_PREFETCH=1

MINIO_ROOT_USER=track_admin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=track-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

TRACK_FILE_MAX_SIZE_BYTES=20971520
TRACK_REQUEST_MAX_SIZE_BYTES=22020096
TRACK_FILE_MAX_ROWS=200000
TRACK_FILE_BATCH_SIZE=500
ANALYSIS_TASK_MAX_ATTEMPTS=3
ANALYSIS_RETRY_DELAY_MILLISECONDS=5000
ANALYSIS_LATEST_CACHE_TTL=PT10M
ANALYSIS_COMPARISON_CACHE_TTL=PT5M
